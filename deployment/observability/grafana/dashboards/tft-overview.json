      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "description": "Route-level volume provides the denominator for the latency panel. The 5-minute window keeps low-volume endpoints from appearing as noisy one-sample spikes.",
      "targets": [
        { "expr": "sum by (http_route) (rate(http_server_request_duration_count[5m]))", "legendFormat": "{{http_route}} · requests/s", "refId": "A" },
        { "expr": "sum by (http_route) (rate(http_server_request_duration_count{http_response_status_code=~\"5..\"}[5m]))", "legendFormat": "{{http_route}} · 5xx/s", "refId": "B" }
      ],
      "title": "HTTP volume and errors by route (5m rate)",
