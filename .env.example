# TFT Deployment Configuration
# Copy this file to .env and fill in your values

# Domain for SSL certificate (e.g., tft.yourdomain.com)
DOMAIN=tft.yourdomain.com

# Required for production WebSocket origin checks
WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=https://tft.yourdomain.com

# Required in the production profile
ANALYTICS_ADMIN_PASSWORD=replace-with-a-strong-password

# Required for the production Grafana instance served below /grafana/
GRAFANA_ROOT_URL=https://tft.yourdomain.com/grafana/
GRAFANA_ADMIN_PASSWORD=replace-with-a-different-strong-password

# Generate with: openssl rand -hex 32
GRAFANA_SECRET_KEY=replace-with-a-64-character-random-hex-value
